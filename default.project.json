{
  "name": "BrewAPotion",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Config": { "$path": "src/ReplicatedStorage/Config" },
      "Effects": { "$path": "src/ReplicatedStorage/Effects" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "Main": { "$path": "src/ServerScriptService/Main.server.lua" },
      "Modules": { "$path": "src/ServerScriptService/Modules" }
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "ClientMain": { "$path": "src/StarterPlayerScripts/ClientMain" }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future"
      }
    }
  }
}
